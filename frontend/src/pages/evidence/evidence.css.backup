.evidence-page {
  min-height: 100vh;
  background: #f4f6f8;
  color: #18232d;
}

.evidence-main {
  margin-left: 258px;
  min-height: 100vh;
}

.evidence-body {
  padding: 0 42px 70px;
}

/* PAGE HEADER */

.evidence-page-header {
  min-height: 145px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28px 6px;
  border-bottom: 1px solid #dfe5e9;
}

.evidence-eyebrow {
  display: block;
  margin-bottom: 9px;
  color: #1769aa;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 2px;
}

.evidence-page-header h1 {
  margin: 0;
  font-size: 34px;
  line-height: 1.15;
  color: #18232d;
}

.evidence-page-header p {
  margin: 8px 0 0;
  color: #71808a;
  font-size: 13px;
}

.evidence-live {
  display: flex;
  align-items: center;
  gap: 8px;
  color: #55717f;
  font-size: 9px;
  font-weight: 700;
  letter-spacing: 1.2px;
}

.evidence-live span {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #3f7d62;
}

/* SELECTOR */

.evidence-selector {
  margin-top: 32px;
  padding: 22px 24px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 30px;
  background: #ffffff;
  border: 1px solid #dce3e7;
  border-radius: 6px;
}

.section-label {
  display: block;
  margin-bottom: 7px;
  color: #84919a;
  font-size: 9px;
  font-weight: 700;
  letter-spacing: 1.3px;
}

.evidence-selector h2 {
  margin: 0;
  font-size: 21px;
  color: #24333e;
}

.evidence-selector p {
  margin: 6px 0 0;
  color: #84919a;
  font-size: 11px;
}

.evidence-selector select {
  min-width: 310px;
  padding: 11px 13px;
  border: 1px solid #ccd6dc;
  border-radius: 4px;
  background: #ffffff;
  color: #24333e;
  font-size: 12px;
  outline: none;
}

/* CASE */

.evidence-case {
  margin-top: 22px;
  display: flex;
  justify-content: space-between;
  background: #1d2a35;
  color: #ffffff;
  border-radius: 6px;
  overflow: hidden;
}

.evidence-case-main {
  padding: 27px 29px;
  flex: 1;
}

.case-kicker {
  margin-bottom: 13px;
  color: #9caab4;
  font-size: 9px;
  font-weight: 700;
  letter-spacing: 1.4px;
}

.case-title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 30px;
}

.case-title-row h2 {
  margin: 0;
  font-size: 30px;
}

.case-title-row p {
  margin: 7px 0 0;
  color: #b9c4ca;
  font-size: 12px;
}

.score-box {
  min-width: 180px;
  text-align: right;
}

.score-box > span {
  display: block;
  margin-bottom: 4px;
  color: #9caab4;
  font-size: 8px;
  font-weight: 700;
  letter-spacing: 1px;
}

.score-box strong {
  display: block;
  color: #ffffff;
  font-size: 26px;
}

.score-box strong small {
  margin-left: 3px;
  color: #9caab4;
  font-size: 10px;
  font-weight: 400;
}

.score-box em {
  display: inline-block;
  margin-top: 5px;
  padding: 4px 8px;
  font-style: normal;
  font-size: 8px;
  font-weight: 700;
  letter-spacing: 1px;
}

.score-box em.high {
  background: #713b3b;
}

.score-box em.medium {
  background: #66582e;
}

.score-box em.low {
  background: #31584a;
}

.case-action {
  display: flex;
  align-items: center;
  padding: 25px;
  border-left: 1px solid #3a4852;
}

.case-action button {
  padding: 10px 14px;
  border: 1px solid #60717c;
  border-radius: 4px;
  background: transparent;
  color: #ffffff;
  font-size: 10px;
  font-weight: 700;
  cursor: pointer;
}

/* SECTIONS */

.evidence-section {
  margin-top: 38px;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16px;
}

.section-header > div {
  display: flex;
  align-items: flex-start;
  gap: 13px;
}

.section-header > div > span {
  color: #1769aa;
  font-size: 10px;
  font-weight: 700;
}

.section-header h2 {
  margin: 0;
  color: #24333e;
  font-size: 19px;
}

.section-header p {
  margin: 5px 0 0;
  color: #84919a;
  font-size: 11px;
}

.section-header > small {
  color: #8a969e;
  font-size: 8px;
  font-weight: 700;
  letter-spacing: 1.2px;
}

/* RAW GRID */

.raw-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  background: #ffffff;
  border: 1px solid #dce3e7;
  border-radius: 6px;
  overflow: hidden;
}

.raw-grid > div {
  min-height: 82px;
  padding: 18px 21px;
  border-right: 1px solid #e5eaed;
  border-bottom: 1px solid #e5eaed;
}

.raw-grid > div:nth-child(3n) {
  border-right: 0;
}

.raw-grid > div:nth-last-child(-n + 3) {
  border-bottom: 0;
}

.raw-grid span {
  display: block;
  margin-bottom: 8px;
  color: #89959d;
  font-size: 8px;
  font-weight: 700;
  letter-spacing: 1px;
}

.raw-grid strong {
  display: block;
  color: #24333e;
  font-size: 12px;
  line-height: 1.4;
}

/* EVIDENCE CHAIN */

.evidence-chain {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 15px;
}

.evidence-card {
  min-height: 185px;
  padding: 20px;
  background: #ffffff;
  border: 1px solid #dce3e7;
  border-radius: 5px;
}

.evidence-card-top {
  display: flex;
  justify-content: space-between;
  gap: 10px;
}

.evidence-card-top span:first-child {
  color: #1769aa;
  font-size: 10px;
  font-weight: 700;
}

.evidence-card-top span:last-child {
  color: #89959d;
  font-size: 7px;
  font-weight: 700;
  letter-spacing: .8px;
  text-align: right;
}

.evidence-card h3 {
  margin: 24px 0 12px;
  color: #24333e;
  font-size: 16px;
}

.evidence-card > strong {
  display: inline-block;
  max-width: 100%;
  padding: 7px 9px;
  background: #f0f5f8;
  color: #315267;
  font-size: 11px;
  overflow-wrap: anywhere;
}

.evidence-card p {
  margin: 14px 0 0;
  color: #7b8790;
  font-size: 10px;
  line-height: 1.6;
}

/* INTERPRETATION */

.interpretation {
  margin-top: 38px;
  display: grid;
  grid-template-columns: 1.5fr .6fr;
  background: #ffffff;
  border: 1px solid #dce3e7;
  border-radius: 6px;
  overflow: hidden;
}

.interpretation-main {
  padding: 26px;
}

.interpretation-main > span {
  color: #84919a;
  font-size: 8px;
  font-weight: 700;
  letter-spacing: 1.2px;
}

.interpretation-main h2 {
  margin: 18px 0 9px;
  color: #24333e;
  font-size: 20px;
}

.interpretation-main p {
  max-width: 680px;
  margin: 0;
  color: #71808a;
  font-size: 11px;
  line-height: 1.7;
}

.interpretation-side {
  display: grid;
  grid-template-columns: 1fr 1fr;
  background: #f8fafb;
  border-left: 1px solid #e0e6e9;
}

.interpretation-side > div {
  padding: 24px 18px;
}

.interpretation-side > div + div {
  border-left: 1px solid #e0e6e9;
}

.interpretation-side span {
  display: block;
  margin-bottom: 8px;
  color: #89959d;
  font-size: 8px;
  font-weight: 700;
  letter-spacing: 1px;
}

.interpretation-side strong {
  font-size: 15px;
}

.high {
  color: #b43d3d;
}

.medium {
  color: #a4761c;
}

.low {
  color: #3f7d62;
}

/* OTHER RECORDS */

.record-list {
  background: #ffffff;
  border: 1px solid #dce3e7;
  border-radius: 6px;
  overflow: hidden;
}

.record-row {
  width: 100%;
  display: grid;
  grid-template-columns: 1.2fr 1.4fr .6fr;
  gap: 20px;
  align-items: center;
  padding: 16px 21px;
  border: 0;
  border-bottom: 1px solid #e7ecef;
  background: #ffffff;
  text-align: left;
  cursor: pointer;
}

.record-row:last-child {
  border-bottom: 0;
}

.record-row:hover {
  background: #f8fafb;
}

.record-row div {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.record-row strong {
  color: #24333e;
  font-size: 11px;
}

.record-row span {
  color: #71808a;
  font-size: 10px;
}

.record-row small {
  width: fit-content;
  padding: 3px 6px;
  font-size: 7px;
  font-weight: 700;
  letter-spacing: .6px;
}

.record-row small.high {
  background: #f8eaea;
}

.record-row small.medium {
  background: #faf3df;
}

.record-row small.low {
  background: #eaf4ef;
}

/* DISCLAIMER */

.evidence-disclaimer {
  margin-top: 22px;
  display: flex;
  gap: 13px;
  padding: 17px 20px;
  background: #eef3f6;
  border: 1px solid #dce4e9;
  border-radius: 6px;
}

.disclaimer-icon {
  width: 20px;
  height: 20px;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #1769aa;
  color: #ffffff;
  font-size: 11px;
  font-weight: 700;
}

.evidence-disclaimer strong {
  display: block;
  margin-bottom: 4px;
  color: #34434d;
  font-size: 10px;
}

.evidence-disclaimer p {
  margin: 0;
  color: #71808a;
  font-size: 10px;
  line-height: 1.5;
}

/* STATES */

.evidence-loading,
.evidence-empty {
  margin: 42px;
  padding: 70px 30px;
  text-align: center;
  background: #ffffff;
  border: 1px solid #dce3e7;
  border-radius: 6px;
}

.evidence-loading {
  color: #71808a;
  font-size: 13px;
}

.evidence-empty h1 {
  margin: 8px 0;
  font-size: 27px;
}

.evidence-empty p {
  color: #71808a;
  font-size: 13px;
}

.evidence-empty button {
  margin-top: 15px;
  padding: 10px 15px;
  border: 0;
  border-radius: 4px;
  background: #1769aa;
  color: #ffffff;
  font-size: 11px;
  font-weight: 700;
  cursor: pointer;
}

/* RESPONSIVE */

@media (max-width: 1100px) {
  .evidence-main {
    margin-left: 258px;
  }

  .evidence-chain {
    grid-template-columns: repeat(2, 1fr);
  }

  .raw-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .raw-grid > div:nth-child(3n) {
    border-right: 1px solid #e5eaed;
  }

  .raw-grid > div:nth-child(2n) {
    border-right: 0;
  }

  .raw-grid > div:nth-last-child(-n + 3) {
    border-bottom: 1px solid #e5eaed;
  }

  .raw-grid > div:nth-last-child(-n + 2) {
    border-bottom: 0;
  }
}

@media (max-width: 750px) {
  .evidence-main {
    margin-left: 0;
  }

  .evidence-body {
    padding: 0 18px 50px;
  }

  .evidence-page-header {
    flex-direction: column;
    align-items: flex-start;
    gap: 15px;
  }

  .evidence-selector {
    flex-direction: column;
    align-items: stretch;
  }

  .evidence-selector select {
    min-width: 0;
  }

  .case-title-row {
    flex-direction: column;
    align-items: flex-start;
  }

  .score-box {
    text-align: left;
  }

  .case-action {
    display: none;
  }

  .evidence-chain,
  .raw-grid,
  .interpretation {
    grid-template-columns: 1fr;
  }

  .raw-grid > div {
    border-right: 0 !important;
    border-bottom: 1px solid #e5eaed !important;
  }

  .raw-grid > div:last-child {
    border-bottom: 0 !important;
  }

  .interpretation-side {
    border-left: 0;
    border-top: 1px solid #e0e6e9;
  }
}
